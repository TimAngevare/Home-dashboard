# Weather (Open-Meteo, no API key required)
WEATHER_LAT=52.2215
WEATHER_LON=6.8937
# Short label shown next to the temperature in the top-bar weather pill
WEATHER_LOCATION_LABEL=Home

# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_token_here
# Comma-separated entity_ids; leave blank for all lights
HA_LIGHT_ENTITY_IDS=
# Comma-separated switch entity_ids to show as toggle tiles
HA_SWITCH_ENTITY_IDS=
# Spotify (or any) media_player entity to show/control on the Media page
HA_MEDIA_PLAYER_ENTITY_ID=media_player.spotify_yourname
# Comma-separated calendar entity_ids (blank = all calendar.* entities)
HA_CALENDAR_ENTITY_IDS=

# OpenWRT (ubus JSON-RPC)
OPENWRT_URL=http://192.168.1.1
OPENWRT_USER=root
OPENWRT_PASSWORD=your_password_here
# l3 device to measure WAN throughput on (eth0/eth1 for plain DHCP WAN,
# pppoe-wan if your ISP connection uses PPPoE)
OPENWRT_WAN_DEVICE=eth1

# Local disk/mount to report storage stats for
STORAGE_PATH=/mnt/storage
STORAGE_LABEL=Storage

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Status values written when a task is ticked / unticked from the dashboard
NOTION_DONE_STATUS=Done
NOTION_OPEN_STATUS=In progress

# n8n (Settings -> n8n API -> create an API key)
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Server
PORT=3001
